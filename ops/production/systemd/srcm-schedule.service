[Unit]
Description=SRCM Laravel scheduler tick
After=network.target php8.3-fpm.service

[Service]
Type=oneshot
User=srcm
Group=www-data
WorkingDirectory=/srv/srcm/current
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/srcm/shared /var/backups/srcm
