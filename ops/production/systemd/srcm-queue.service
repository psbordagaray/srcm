[Unit]
Description=SRCM Laravel queue worker
After=network.target php8.3-fpm.service
Requires=php8.3-fpm.service

[Service]
Type=simple
User=srcm
Group=www-data
WorkingDirectory=/srv/srcm/current
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --timeout=90 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/srcm/shared /var/backups/srcm

[Install]
WantedBy=multi-user.target
