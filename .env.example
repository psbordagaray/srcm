APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires


# P5.5 Mercado Pago connection secret map.
# Production: inject this as a process environment variable / secret source.
# Never commit real values.
SRCM_MERCADO_PAGO_CONNECTION_SECRETS_JSON=


# ARCA WSAA/WSFE homologation remains disabled until explicitly configured.
# Endpoints and service identity are infrastructure configuration only.
# Credential material itself must never be committed here.
ARCA_HOMOLOGATION_ENABLED=false
ARCA_HOMOLOGATION_WSAA_ENDPOINT=
ARCA_HOMOLOGATION_BUSINESS_ENDPOINT=
ARCA_HOMOLOGATION_SERVICE_NAME=

# JSON object keyed by organization_id.
# Each entry contains only opaque references, never certificate/private-key
# contents or passphrases. Inject the real map outside version control.
# Shape:
# {"1":{"service":"service-name","issuer_cuit":"20123456789","certificate_reference":"opaque-ref","private_key_reference":"opaque-ref","private_key_passphrase_reference":null}}
SRCM_ARCA_WSAA_CREDENTIAL_REFERENCES_JSON=
