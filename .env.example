APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# P11 production observability baseline.
# Production: LOG_CHANNEL=stderr_json and LOG_LEVEL=info.
# Local development may keep stack/single and Laravel Pail.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# P11 production security baseline. Development defaults above remain local-safe.
# Production must override APP_DEBUG=false, APP_URL=https://...,
# SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true. Password confirmation
# for protected high-impact operations must expire in <= 1800 seconds.
AUTH_PASSWORD_TIMEOUT=900

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# P11 production resilience baseline.
# Production must point SRCM_BACKUP_DIRECTORY outside the repository tree,
# preferably to a separate OS-encrypted volume. The application scheduler
# creates one verified SQLite snapshot per hour and retains 168 by default.
SRCM_BACKUP_ENABLED=true
SRCM_BACKUP_DB_CONNECTION=sqlite
SRCM_BACKUP_DIRECTORY=
SRCM_BACKUP_RETENTION_COUNT=168
SRCM_BACKUP_FRESHNESS_MINUTES=90
SRCM_RPO_MINUTES=60
SRCM_RTO_MINUTES=240

# P11 off-host encrypted backup capability. Remains disabled until a real
# remote provider + credentials + encryption key reference are configured and
# separately smoked. The referenced key value must be injected outside VCS.
SRCM_BACKUP_OFF_HOST_ENABLED=false
SRCM_BACKUP_REMOTE_DISK=srcm_backup_s3
SRCM_BACKUP_REMOTE_PREFIX=srcm/backups/database
SRCM_BACKUP_ENCRYPTION_KEY_ID=
# Example only: env:SRCM_BACKUP_ENCRYPTION_KEY_V1
SRCM_BACKUP_ENCRYPTION_KEY_REFERENCE=
SRCM_BACKUP_ENCRYPTION_CHUNK_BYTES=1048576

# Dedicated S3-compatible backup transport. Keep real credentials and endpoint
# outside version control. The adapter may target AWS S3 or an S3-compatible
# provider; no provider is selected merely by these empty configuration slots.
SRCM_BACKUP_S3_ACCESS_KEY_ID=
SRCM_BACKUP_S3_SECRET_ACCESS_KEY=
SRCM_BACKUP_S3_REGION=us-east-1
SRCM_BACKUP_S3_BUCKET=
SRCM_BACKUP_S3_ENDPOINT=
SRCM_BACKUP_S3_USE_PATH_STYLE_ENDPOINT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires


# P5.5 Mercado Pago connection secret map.
# Production: inject this as a process environment variable / secret source.
# Never commit real values.
SRCM_MERCADO_PAGO_CONNECTION_SECRETS_JSON=


# ARCA WSAA/WSFE homologation remains disabled until explicitly configured.
# Endpoints and service identity are infrastructure configuration only.
# Credential material itself must never be committed here.
ARCA_HOMOLOGATION_ENABLED=false
ARCA_HOMOLOGATION_WSAA_ENDPOINT=
ARCA_HOMOLOGATION_BUSINESS_ENDPOINT=
ARCA_HOMOLOGATION_SERVICE_NAME=

# JSON object keyed by organization_id.
# Each entry contains only opaque references, never certificate/private-key
# contents or passphrases. Inject the real map outside version control.
# `service` must satisfy the WSAA XSD: 3..32 chars, letter first, then
# letters/digits/underscore.
# Concrete local resolution uses file:<relative-path> below a dedicated
# external root and optional env:<VARIABLE> for the private-key passphrase.
# Never point the root at the repository or one of its ancestors.
SRCM_ARCA_WSAA_CREDENTIAL_ROOT=
# Shape:
# {"1":{"service":"wsfe","issuer_cuit":"20123456789","certificate_reference":"file:certificates/org-1.pem","private_key_reference":"file:private-keys/org-1.key","private_key_passphrase_reference":"env:SRCM_ARCA_WSAA_ORG_1_KEY_PASSPHRASE"}}
SRCM_ARCA_WSAA_CREDENTIAL_REFERENCES_JSON=
